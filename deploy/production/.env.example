DOMAIN_FRONTEND=tykfk.site
DOMAIN_API=api.tykfk.site

POSTGRES_DB=surebet
POSTGRES_USER=surebet
POSTGRES_PASSWORD=change-me

BACKEND_APP_NAME=surebet-platform
BACKEND_APP_ENV=production
AUTH_TOKEN_SECRET=change-me
AUTH_TOKEN_TTL=12h
INTERNAL_API_TOKEN=change-me
COLLECTOR_STREAM_AUTH_REQUIRED=true
JUN88_ACCOUNT_ID=surebet-primary
EIGHTXBET_ACCOUNT_ID=surebet-primary
COLLECTOR_STREAM_JUN88_TOKEN=change-me
COLLECTOR_STREAM_EIGHTXBET_TOKEN=change-me
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

SUREBET_VERIFICATION_MODE=auto
SUREBET_CONFIRM_TIMEOUT=2s
SUREBET_CONFIRM_VALIDITY=2s
SUREBET_CONFIRM_MAX_SKEW=1s
SUREBET_SHADOW_DURATION=30m
SUREBET_SHADOW_MIN_SAMPLES=20
SUREBET_SHADOW_MIN_SUCCESS_RATE=0.80
SUREBET_SHADOW_MAX_P95_LATENCY=1500ms

# Auto-bet chỉ còn hai khóa: off | simulation | dry-run | live và tổng vốn
# tối đa cho một cặp cược. Jun88 được cố định 1 VD = 1.000 VND.
AUTO_BET_MODE=off
AUTO_BET_TOTAL_STAKE_VND=100000

LARAVEL_APP_ENV=production
LARAVEL_APP_TIMEZONE=Asia/Ho_Chi_Minh

SEED_FRONTEND_USER_ID=surebet-operator
SEED_FRONTEND_USER_EMAIL=operator@tykfk.site
SEED_FRONTEND_USER_PASSWORD=change-me
SEED_FRONTEND_USER_FULL_NAME=Surebet Operator
SEED_FRONTEND_USER_ROLE=operator

SEED_SUPER_ADMIN_ID=surebet-super-admin
SEED_SUPER_ADMIN_EMAIL=superadmin@tykfk.site
SEED_SUPER_ADMIN_PASSWORD=change-me
SEED_SUPER_ADMIN_FULL_NAME=Surebet Super Admin
SEED_SUPER_ADMIN_ROLE=super_admin

ODDS_RETENTION_ACTIVE_HOURS=24
ODDS_RETENTION_FINISHED_MINUTES=30
# Keep v1 during shadow monitoring; switch to v2 only after both sources pass
# deploy/production/report-odds-v3-shadow.sh for 7-14 days.
ODDS_STATE_PROTOCOL=v2

NEXT_PUBLIC_BACKEND_API_URL=https://api.tykfk.site
NEXT_PUBLIC_BACKEND_WS_URL=wss://api.tykfk.site/v1/ws
FRONTEND_BACKEND_API_URL=http://backend-api:8080

EIGHTXBET_BASE_URL=https://8x2000.com
EIGHTXBET_INPLAY_PAGE_URL=https://8x2000.com/sportEvents/inplay/football
EIGHTXBET_LOGIN_USERNAME=
EIGHTXBET_LOGIN_PASSWORD=
JUN88_BASE_URL=https://www.junn8811.cc
JUN88_CMD_PAGE_URL=https://www.junn8811.cc/vi-vn/sports-landing/cmd
JUN88_LOGIN_USERNAME=
JUN88_LOGIN_PASSWORD=

# Collector has stable runtime defaults. Only set this when you need to see
# the browser while debugging locally.
COLLECTOR_HEADLESS=true
