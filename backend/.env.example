APP_NAME=surebet-platform
APP_ENV=development

AUTH_TOKEN_SECRET=surebet-dev-secret-change-me
AUTH_TOKEN_TTL=12h

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

POSTGRES_DSN=postgres://surebet:surebet@127.0.0.1:5432/surebet?sslmode=disable

INTERNAL_API_TOKEN=
COLLECTOR_STREAM_AUTH_REQUIRED=false
JUN88_ACCOUNT_ID=
EIGHTXBET_ACCOUNT_ID=
COLLECTOR_STREAM_JUN88_TOKEN=
COLLECTOR_STREAM_EIGHTXBET_TOKEN=
# Authenticated v4 collectors publish current balance telemetry. The backend
# keeps it as volatile monitoring state and never uses it to authorize a bet.
ODDS_STATE_PROTOCOL=v1
SUREBET_VERIFICATION_MODE=shadow
SUREBET_CONFIRM_TIMEOUT=2s
SUREBET_CONFIRM_VALIDITY=2s
SUREBET_CONFIRM_MAX_SKEW=1s
SUREBET_SHADOW_DURATION=30m
SUREBET_SHADOW_MIN_SAMPLES=20
SUREBET_SHADOW_MIN_SUCCESS_RATE=0.80
SUREBET_SHADOW_MAX_P95_LATENCY=1500ms

# off | simulation | dry-run | live. Các giới hạn an toàn khác được cố định
# trong backend cho mô hình một tài khoản chạy trên máy cá nhân.
AUTO_BET_MODE=off
AUTO_BET_TOTAL_STAKE_VND=100000
