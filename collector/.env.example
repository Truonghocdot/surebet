# Collector local settings. Auto-bet is controlled from the frontend; there is
# no collector-side auto-bet switch to configure.

# Backend connection and stream identity.
BACKEND_API_URL=http://127.0.0.1:8080
COLLECTOR_ACCOUNT_ID=
COLLECTOR_STREAM_TOKEN=

# Bookmaker credentials. Login starts automatically when both fields exist.
EIGHTXBET_LOGIN_USERNAME=
EIGHTXBET_LOGIN_PASSWORD=
JUN88_LOGIN_USERNAME=
JUN88_LOGIN_PASSWORD=

# Optional: set false only when you need to watch the browser locally.
COLLECTOR_HEADLESS=true
